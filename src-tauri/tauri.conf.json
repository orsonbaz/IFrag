{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IFrag",
  "version": "0.1.0",
  "identifier": "com.ifrag.desktop",
  "build": {
    "beforeDevCommand": "node ./bin/ifrag.js --port 4173 --no-open",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../build/client"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "IFrag",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "url": "http://127.0.0.1:4173"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Local fragrance formulation tool with IFRA compliance",
    "longDescription": "IFrag — formulate fragrances on your own machine, check against IFRA standards live, log trials and evaluations."
  }
}
