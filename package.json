    "get-port": "^7.1.0",
    "open": "^10.1.0",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
